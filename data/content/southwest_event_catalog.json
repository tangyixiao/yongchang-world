          "slot": 3,
          "title_cn": "十二版纳分担",
          "desc_cn": "朝贡与防务之费浩繁，议事庭请十二版纳均摊，召片领欲以王命独断。",
          "title_en": "Sharing the Twelve Banners",
          "desc_en": "Tribute and defence cost dearly: the council asks all twelve banners to share, the Chao Phaendin would decide alone.",
          "choices": [
            {
              "label_cn": "依例十二版纳均摊",
              "label_en": "Share it across the twelve banners",
              "ops": [
                {
                  "op": "marker",
                  "name": "ywc_sw_sip_e3_done"
                },
                {
                  "op": "marker",
                  "name": "ywc_sw_sip_resolved"
