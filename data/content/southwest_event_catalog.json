                {
                  "op": "modifier",
                  "name": "ywc_sw_levy_burden",
                  "months": 12
                }
              ]
            },
            {
              "label_cn": "召片领独任，以王命压之",
              "label_en": "The Chao Phaendin bears it alone",
              "ops": [
                {
                  "op": "marker",
                  "name": "ywc_sw_sip_e3_done"
                },
                {
                  "op": "marker",
                  "name": "ywc_sw_sip_failed"
